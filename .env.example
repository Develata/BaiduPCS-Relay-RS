# Docker Compose host settings
BIND_ADDRESS=127.0.0.1
HOST_PORT=5200
IMAGE_TAG=local

# Baidu account cookies used by share verification and transfer
BDUSS=
STOKEN=
SAVE_PATH=/文档加工
HTTP_TIMEOUT_SECS=30

# Relay service authentication and local download signing
WEB_ACCESS_TOKEN=
WEB_SIGN_SECRET=

# Baidu OAuth: either provide an access token, or provide the OAuth client
# credentials and authorize through the web UI. OOB is recommended locally.
BAIDU_ACCESS_TOKEN=
BAIDU_REFRESH_TOKEN=
BAIDU_CLIENT_ID=
BAIDU_CLIENT_SECRET=
BAIDU_REDIRECT_URI=oob

# Optional outbound proxy. Leave empty when Docker can access Baidu directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
